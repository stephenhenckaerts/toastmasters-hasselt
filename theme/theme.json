{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "75rem",
			"wideSize": "75rem"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "blue", "color": "#004165", "name": "Loyal Blue" },
				{ "slug": "blue-lift", "color": "#006094", "name": "Blissful Blue" },
				{ "slug": "blue-deep", "color": "#00314E", "name": "Diep blauw" },
				{ "slug": "blue-950", "color": "#001626", "name": "Nachtblauw" },
				{ "slug": "maroon", "color": "#A03C4B", "name": "Maroon (inkt)" },
				{ "slug": "maroon-deep", "color": "#772432", "name": "True Maroon" },
				{ "slug": "yellow", "color": "#F2DF74", "name": "Happy Yellow" },
				{ "slug": "ground", "color": "#F5F5F5", "name": "Fair Gray" },
				{ "slug": "surface", "color": "#FFFFFF", "name": "Wit" },
				{ "slug": "surface-2", "color": "#E7E9E9", "name": "Lichtgrijs" },
				{ "slug": "ink", "color": "#1A1A1A", "name": "Inkt" },
				{ "slug": "ink-2", "color": "#5B656D", "name": "Inkt zacht" },
				{ "slug": "ink-3", "color": "#788289", "name": "Inkt licht" },
				{ "slug": "line", "color": "#DADEDD", "name": "Lijn" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Source Sans 3",
					"fontFamily": "\"Source Sans 3\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "serif",
					"name": "Source Serif 4",
					"fontFamily": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "clamp(0.95rem, 0.9rem + 0.2vw, 1rem)" },
				{ "slug": "medium", "name": "Normaal", "size": "clamp(1.13rem, 1.06rem + 0.3vw, 1.2rem)" },
				{ "slug": "large", "name": "Groot", "size": "clamp(1.3rem, 1.15rem + 0.7vw, 1.7rem)" },
				{ "slug": "x-large", "name": "Zeer groot", "size": "clamp(1.7rem, 1.4rem + 1.5vw, 2.6rem)" },
				{ "slug": "xx-large", "name": "Kop", "size": "clamp(2.1rem, 1.5rem + 3vw, 3.6rem)" },
				{ "slug": "huge", "name": "Hero", "size": "clamp(2.6rem, 1.9rem + 3vw, 4.3rem)" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "clamp(1rem, 0.9rem + 0.5vw, 1.5rem)" },
				{ "slug": "30", "name": "2", "size": "clamp(1.5rem, 1.3rem + 1vw, 2.5rem)" },
				{ "slug": "40", "name": "3", "size": "clamp(2.5rem, 2rem + 2vw, 4rem)" },
				{ "slug": "50", "name": "4", "size": "clamp(4rem, 3rem + 4vw, 6.5rem)" },
				{ "slug": "60", "name": "5", "size": "clamp(4.5rem, 3rem + 6vw, 8.75rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ground)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1.25rem, 5vw, 2rem)",
				"right": "clamp(1.25rem, 5vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--maroon)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--maroon-deep)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "700",
					"lineHeight": "1.06",
					"letterSpacing": "-0.022em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": { "radius": "7px" },
				"spacing": {
					"padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.6rem", "right": "1.6rem" }
				},
				"typography": { "fontWeight": "700" },
				":hover": {
					"color": { "background": "var(--wp--preset--color--blue-lift)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--blue-lift)" }
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--maroon)",
						"width": "4px",
						"style": "solid"
					}
				},
				"spacing": { "padding": { "left": "1.5rem" } }
			},
			"core/pullquote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--maroon)",
						"width": "5px",
						"style": "solid"
					}
				}
			},
			"core/post-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
			}
		}
	},
	"templateParts": [
		{ "name": "strip", "title": "Meeting-balk", "area": "uncategorized" },
		{ "name": "header", "title": "Kop", "area": "header" },
		{ "name": "footer", "title": "Voet", "area": "footer" }
	]
}
